# ==============================================================================
# DevSphere Backend Environment Configuration (.env.example)
# Copy this file to .env and fill in real values before deploying or running.
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE SERVER CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# Execution environment: 'development' | 'production' | 'test'
NODE_ENV=production

# HTTP Port (Render automatically supplies PORT in production)
PORT=5000

# MongoDB Atlas connection URI with database name
# In production, ensure user credentials and IP allowlists are configured in Atlas
MONGO_URI=mongodb+srv://db_user:StrongPassword123@cluster0.abcde.mongodb.net/devsphere_prod?retryWrites=true&w=majority

# Access Token Secret: MUST be at least 32 random characters in production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=f3a8c14d9b2e7a0f6c5d4e3b2a109876543210fedcba9876543210abcdef1234

# Refresh Token Secret: MUST be at least 32 characters AND DISTINCT from JWT_SECRET
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_REFRESH_SECRET=a1b2c3d4e5f60718293a4b5c6d7e8f90123456789abcdef0123456789abcdef0

# Allowed CORS Frontend Origin & Transactional Email Link Base (REQUIRED in production)
# In production, must be the exact HTTPS origin where the React app is hosted (no trailing slash)
FRONTEND_URL=https://devsphere.vercel.app

# ------------------------------------------------------------------------------
# INITIAL ADMIN SEEDING & SECURITY
# ------------------------------------------------------------------------------
# Secret token used by admin seed scripts or first-time setup
ADMIN_INVITATION_SECRET=secret_admin_seed_token_change_in_production_89123

# ------------------------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY (OPTIONAL FOR DEV, REQUIRED FOR PRODUCTION BOOKING)
# ------------------------------------------------------------------------------
# Obtain from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=yyyyyyyyyyyyyyyyyyyyyyyy

# Webhook Secret: Configured under Razorpay Dashboard -> Settings -> Webhooks
# Events to subscribe: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_signature_key

# ------------------------------------------------------------------------------
# TRANSACTIONAL EMAIL DELIVERY (SMTP) (OPTIONAL FOR DEV, REQUIRED FOR PROD NOTICES)
# ------------------------------------------------------------------------------
# Example: Gmail App Password, SendGrid, or Amazon SES
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@devsphere.io
SMTP_PASS=xxxx yyyy zzzz wwww
SMTP_FROM=DevSphere Notifications <no-reply@devsphere.io>

# ------------------------------------------------------------------------------
# AI MOCK INTERVIEWER LLM (AT LEAST ONE KEY REQUIRED FOR AI INTERVIEWS)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Recommended)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Alternative fallback)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# CLOUDINARY AVATAR & ASSET STORAGE (OPTIONAL FOR DEV, REQUIRED FOR UPLOADS)
# ------------------------------------------------------------------------------
# Obtain from Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=devsphere-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12345

# ------------------------------------------------------------------------------
# WEBRTC / TURN RELAY SERVERS (CRITICAL FOR USERS BEHIND NAT / FIREWALLS)
# ------------------------------------------------------------------------------
# TURN configuration for WebRTC sessions (metered.ca, Twilio, or self-hosted coturn)
TURN_SERVER_URLS=turn:turn.metered.ca:443?transport=tcp
TURN_USERNAME=devsphere_turn_user
TURN_CREDENTIAL=devsphere_turn_password_or_token

# ------------------------------------------------------------------------------
# GOOGLE OAUTH 2.0 (OPTIONAL FOR DEV, REQUIRED FOR GOOGLE LOGIN)
# ------------------------------------------------------------------------------
# Google Cloud Console Web Client ID
GOOGLE_CLIENT_ID=123456789012-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
