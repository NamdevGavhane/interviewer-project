# ==============================================================================
# DevSphere Frontend Environment Configuration (.env.example)
# Copy this file to .env in production deployment (e.g. Vercel / Render Static)
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND API ENDPOINT (REQUIRED)
# ------------------------------------------------------------------------------
# The HTTPS URL of the deployed Express backend (no trailing slash)
# Fatal startup validation will alert if omitted in production
VITE_API_URL=https://interviewer-api.onrender.com

# ------------------------------------------------------------------------------
# THIRD-PARTY CLIENT INTEGRATIONS
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID (matches backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=123456789012-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Razorpay Public Key ID (Frontend checkout modal, matches backend RAZORPAY_KEY_ID)
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# SELF-HOSTED WEBRTC / PEERJS SIGNALLING CONFIGURATION (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# Self-hosted PeerJS signalling server mounted on Express backend at /peerjs
# VITE_PEER_HOST is required in production (e.g. interviewer-api.onrender.com)
VITE_PEER_HOST=interviewer-api.onrender.com
VITE_PEER_PORT=443
VITE_PEER_PATH=/peerjs
VITE_PEER_SECURE=true
VITE_PEER_KEY=peerjs
